function matchGame(el, ws, onDone){
  const rounds = []; for(let i=0;i<ws.length;i+=5) rounds.push(ws.slice(i,i+5)); let r = 0;
  const drawRound = () => {
    if(r >= rounds.length){ onDone(); return; }
    const set = rounds[r]; let sel = null, left = set.length;
    const rightCol = shuffle(set.map(w=>({id:w.id, t:w.th, h:0})));
    const tiles = shuffle(set.map(w=>({id:w.id, t:w.h, h:1}))).map((x,i)=>[x, rightCol[i]]);
    el.innerHTML = `<div class="card stack"><div class="eyebrow">เกมจับคู่ รอบ ${r+1}/${rounds.length}</div><p class="small muted" style="margin:0">แตะคำจีนแล้วแตะความหมายที่ตรงกัน</p><div class="match">${tiles.map(([a,b])=>`<button class="tile h" data-id="${a.id}" data-h="1">${esc(a.t)}</button><button class="tile" data-id="${b.id}" data-h="0">${esc(b.t)}</button>`).join("")}</div></div>`;
    el.querySelectorAll(".tile").forEach(t => t.onclick = () => {
      if(t.classList.contains("gone")) return;
      if(t.dataset.h==="1") speak(WORD[t.dataset.id].h);
      if(!sel){ sel = t; t.classList.add("sel"); return; }
      if(sel === t){ t.classList.remove("sel"); sel = null; return; }
      if(sel.dataset.h === t.dataset.h){ sel.classList.remove("sel"); sel = t; t.classList.add("sel"); return; }
      if(sel.dataset.id === t.dataset.id){ sel.classList.add("gone"); t.classList.add("gone"); sel = null; left--; if(left===0){ r++; setTimeout(drawRound, 350); } }
      else { const a = sel; a.classList.remove("sel"); a.classList.add("shake"); t.classList.add("shake"); setTimeout(()=>{a.classList.remove("shake"); t.classList.remove("shake");}, 400); sel = null; }
    });
  };
  drawRound();
}
