function learnedCount(){ return Object.keys(S.srs).filter(k=>WORD[k]&&WORD[k].lv===4).length; }
function masteredCount(){ return Object.values(S.srs).filter(v=>v[0]>=4).length; }
function dueCards(){ const t = localDayNum(); return Object.keys(S.srs).filter(k => S.srs[k][1] <= t).map(Number); }
function srsAdd(id){ if(!S.srs[id]) S.srs[id] = [0, localDayNum()+1]; }
function srsAnswer(id, ok){
  const t = localDayNum(); const c = S.srs[id] || [0,t];
  if(ok){ const b = Math.min(c[0]+1, BOX_DAYS.length-1); S.srs[id] = [b, t + BOX_DAYS[b]]; }
  else S.srs[id] = [0, t+1];
  S.stats.rev++; if(ok) S.stats.revOk++;
}

