<script>
"use strict";
/* ============ DATA ============ */
const DATA = JSON.parse(document.getElementById("hskdata").textContent);
const V4 = DATA.v4.map(a => ({id:a[0], h:a[1], py:a[2], pos:a[3], th:a[4], ex:a[5], exth:a[6], lv:4}));
const V13 = DATA.v13.map(a => ({id:a[0], h:a[1], py:a[2], pos:a[3], th:a[4], lv:a[5]}));
const WORD = {}; V4.concat(V13).forEach(w => WORD[w.id] = w);
const GRAM = DATA.g; const GRAMBY = {}; GRAM.forEach(g => GRAMBY[g.id] = g);
const DLG = DATA.dl; const SP = DATA.sp; const TESTS = DATA.t;
const TOTAL_DAYS = 90, LEARN_DAYS = 60, GRAM_DAYS = 57;
const TEST_DAYS = {15:0, 30:1, 45:2, 60:3, 75:4, 88:5};

/* ============ UTIL ============ */
const $ = (s, r=document) => r.querySelector(s);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function rng(seed){ let s = seed >>> 0 || 1; return () => { s ^= s << 13; s >>>= 0; s ^= s >> 17; s ^= s << 5; s >>>= 0; return s / 4294967296; }; }
function shuffle(arr, r=Math.random){ const a = arr.slice(); for(let i=a.length-1;i>0;i--){ const j = Math.floor(r()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; } return a; }
const pick = (arr, n, r=Math.random) => shuffle(arr, r).slice(0, n);
const L = i => "ABCDEF"[i];
function localDayNum(d=new Date()){ return Math.floor((d.getTime() - d.getTimezoneOffset()*60000)/86400000); }
function dateToDayNum(str){ const [y,m,dd] = str.split("-").map(Number); return Math.floor(Date.UTC(y,m-1,dd)/86400000); }
function dayNumToDate(n){ const d = new Date(n*86400000); return d.toISOString().slice(0,10); }
function thaiDate(n){ const d = new Date(n*86400000); return d.toLocaleDateString("th-TH",{day:"numeric",month:"short",year:"2-digit",timeZone:"UTC"}); }
function toast(msg){ const t = document.createElement("div"); t.className="toast"; t.textContent = msg; document.body.appendChild(t); setTimeout(()=>t.remove(), 2200); }

/* ============ STATE + SYNC ============ */
const LS_KEY = "hsk4-90-v1";
function freshState(){ return { v:1, start: dayNumToDate(localDayNum()), xp:0, streak:{cur:0,best:0,last:null},
  days:{}, srs:{}, mist:[], hwd:{}, gram:{}, dlg:{}, tests:{}, badges:{}, xplog:{}, stats:{rev:0, revOk:0, warm:0},
  settings:{rate:0.85, py:true, th:true}, onboarded:false, updatedAt:0 }; }
let S = freshState();
try { const raw = localStorage.getItem(LS_KEY); if(raw){ S = Object.assign(freshState(), JSON.parse(raw)); } } catch(e){}
let DB = null, DOC = null, saveTimer = null, saving = false, dirty = false, syncState = "local";
function save(){
  S.updatedAt = Date.now();
  try { localStorage.setItem(LS_KEY, JSON.stringify(S)); } catch(e){}
  dirty = true; clearTimeout(saveTimer); saveTimer = setTimeout(flush, 1500);
}
async function flush(){
  if(!DOC || saving || !dirty) return;
  saving = true; dirty = false;
  try { await DOC.set(JSON.parse(JSON.stringify(S))); syncState = "cloud"; }
  catch(e){ syncState = "local"; }
  saving = false; updateSyncChip();
  if(dirty) { clearTimeout(saveTimer); saveTimer = setTimeout(flush, 1500); }
}
async function initCloud(){
  try {
    if(!window.claude || !window.claude.use) return;
    const [db, user] = await Promise.all([window.claude.use("db"), window.claude.use("user")]);
    if(!db || !user) return;
    const uid = await user.id(); if(!uid) return;
    DOC = db.doc("data/users/" + uid + "/progress");
    const snap = await DOC.get();
    if(snap.exists){
      const remote = snap.data();
      if(remote && (remote.updatedAt||0) > (S.updatedAt||0)){ S = Object.assign(freshState(), JSON.parse(JSON.stringify(remote))); try{ localStorage.setItem(LS_KEY, JSON.stringify(S)); }catch(e){} render(); }
      else if((S.updatedAt||0) > (remote?.updatedAt||0)) { dirty = true; flush(); }
    } else if(S.updatedAt) { dirty = true; flush(); }
    syncState = "cloud"; updateSyncChip();
  } catch(e){ syncState = "local"; updateSyncChip(); }
}
function updateSyncChip(){ const c = $("#syncchip"); if(c){ c.textContent = syncState==="cloud" ? "☁ บันทึกในบัญชี" : "💾 บันทึกในเครื่อง"; } }

/* ============ AI (sample) ============ */
let AI = null;
async function initAI(){ try { if(window.claude && window.claude.use) AI = await window.claude.use("sample"); } catch(e){ AI = null; } render(); }

/* ============ TTS ============ */
const TTS = { voice:null, ok: "speechSynthesis" in window, token:0 };
function pickVoice(){ if(!TTS.ok) return; const vs = speechSynthesis.getVoices(); TTS.voice = vs.find(v=>/zh[-_]CN/i.test(v.lang)) || vs.find(v=>/^zh/i.test(v.lang)) || null; }
if(TTS.ok){ pickVoice(); speechSynthesis.onvoiceschanged = pickVoice; }
function stopSpeak(){ TTS.token++; if(TTS.ok) speechSynthesis.cancel(); document.querySelectorAll(".playing").forEach(e=>e.classList.remove("playing")); }
function speakOne(text, opt={}){
  return new Promise(res => {
    if(!TTS.ok || !text){ res(); return; }
    const parts = String(text).split(/(?<=[。！？!?；])/).filter(s=>s.trim());
    let i = 0; const my = TTS.token;
    const next = () => {
      if(my !== TTS.token || i >= parts.length){ res(); return; }
      const u = new SpeechSynthesisUtterance(parts[i++]);
      u.lang = "zh-CN"; if(TTS.voice) u.voice = TTS.voice;
      u.rate = opt.rate || S.settings.rate || 0.85; u.pitch = opt.pitch || 1;
      u.onend = next; u.onerror = next;
      speechSynthesis.speak(u);
    };
    next();
  });
}
async function speak(text, opt){ stopSpeak(); await speakOne(text, opt); }
function pitchFor(s){ return /女|妈|姐|妹|小丽|小红|丽|娜|芳|美|王老师/.test(s||"") ? 1.25 : (/男|爸|哥|弟|先生|刚|明|强|伟/.test(s||"") ? 0.82 : 1); }
async function speakLines(lines, onLine){
  stopSpeak(); const my = TTS.token;
  for(let i=0;i<lines.length;i++){
    if(my !== TTS.token) return false;
    onLine && onLine(i);
    await speakOne(lines[i].t || lines[i].zh, {pitch: pitchFor(lines[i].s)});
    await new Promise(r=>setTimeout(r, 250));
  }
  onLine && onLine(-1);
  return my === TTS.token;
}
const sayBtn = (text, label="🔊") => `<button class="iconbtn say" data-say="${esc(text)}" aria-label="ฟังเสียง">${label}</button>`;

/* ============ PLAN ============ */
const WORD_ORDER = shuffle(V4.map(w=>w.id), rng(4242));
function wordsForDay(d){ if(d<1||d>LEARN_DAYS) return []; const a = Math.floor((d-1)*1000/LEARN_DAYS), b = Math.floor(d*1000/LEARN_DAYS); return WORD_ORDER.slice(a,b); }
function gramForDay(d){ if(d<1||d>GRAM_DAYS) return []; const a = Math.floor((d-1)*76/GRAM_DAYS), b = Math.floor(d*76/GRAM_DAYS); return GRAM.slice(a,b).map(g=>g.id); }
const HW = DATA.hw.split("");
function hwForDay(d){ if(d<=LEARN_DAYS){ const a = Math.floor((d-1)*150/LEARN_DAYS), b = Math.floor(d*150/LEARN_DAYS); return HW.slice(a,b); } return pick(HW, 5, rng(d*97)); }
const WR = DATA.wr;
function weekOf(d){ return Math.ceil(d/7); }
function plan(d){
  const p = { d, week: weekOf(d), phase: d<=LEARN_DAYS ? "เรียนเนื้อหาใหม่" : (d<=83 ? "ฝึกเข้มเหมือนสอบจริง" : "โค้งสุดท้าย"), quests: [] };
  const q = (id, icon, title, sub, xp) => p.quests.push({id, icon, title, sub, xp});
  const test = TEST_DAYS[d];
  q("warm","热","อุ่นเครื่อง: ศัพท์ HSK 1–3", "เกมเร็ว 10 ข้อ ทวนพื้นฐาน", 10);
  const words = wordsForDay(d);
  if(words.length) q("new","新",`ศัพท์ใหม่ ${words.length} คำ`, "การ์ดคำศัพท์ + เกมจับคู่", words.length*2);
  q("review","复","ทบทวนตามรอบความจำ (SRS)", "ระบบเลือกคำที่ถึงรอบทบทวนให้เอง", 15);
  if(test === undefined || d <= LEARN_DAYS){
    const gs = gramForDay(d);
    if(gs.length) q("gram","语",`ไวยากรณ์: ${gs.map(i=>GRAMBY[i].title).join(" · ")}`, "อ่านคำอธิบาย ฟังตัวอย่าง ทำแบบฝึก", 20*gs.length);
    else if(test === undefined) q("gramdrill","练","ศึกไวยากรณ์ 10 ข้อ", "สุ่มจากไวยากรณ์ทั้งหมดที่เรียนแล้ว", 25);
  }
  { const hc = hwForDay(d); q("write","写",`เวิร์กช็อปเขียน: คัด ${hc.join(" ")} · เรียงประโยค · จับผิด · แปล · แต่งประโยค`, d<=LEARN_DAYS ? "ใช้ศัพท์และไวยากรณ์ของวันนี้ ผิดตรงไหนมีคำอธิบายภาษาไทย" : "ทบทวนเข้มแบบข้อสอบ ผิดตรงไหนมีคำอธิบายภาษาไทย", 45); }
  if(test === undefined){
    if(d<=LEARN_DAYS && d%2===1){ const k=(d-1)/2; q("dlg","话",`บทสนทนา: ${DLG[k].topic}`, DLG[k].topicTh + " · ฟัง อ่าน ตอบคำถาม", 25); }
    else if(d>LEARN_DAYS){ const k=(d-61)%30; q("listen","听",`ฟังจับใจความ: ${DLG[k].topic}`, "ฟังอย่างเดียวก่อน แล้วตอบคำถาม", 25); }
    if(d>LEARN_DAYS && d%2===1){ const k=(d-61)/2; q("essay","文",`เรียงความสั้น ≥80 ตัวอักษร`, SP.essays[k].promptTh.slice(0,60)+"…", 35); }
    if(d<=LEARN_DAYS){
      if(d%2===0){ q("speak","说","พูดแสดงความคิดเห็น", SP.opinion[d/2-1].qTh, 25); }
      else { q("shadow","跟","พูดตามบทสนทนา (Shadowing)", "ฟังทีละประโยคแล้วพูดตามออกเสียง", 20); }
    } else if((d-61)%3===0){ q("story","图","เล่าเรื่องจากภาพ 3 ช่อง", "ข้อสอบพูดส่วนที่ 2 · 2 นาที", 30); }
    else { q("speak","说","พูดแสดงความคิดเห็น (รอบทบทวน)", SP.opinion[(d-61)%30].qTh, 25); }
  } else {
    q("test","考",`ข้อสอบจำลอง ${TESTS[test].title}`, "ฟัง 32 · อ่าน 32 · เขียน 6 + พูด · พร้อมเฉลยละเอียด", 150);
  }
  if(d%7===0 && d<90) q("boss","王",`บอสประจำสัปดาห์ที่ ${d/7}`, "15 ข้อรวมศัพท์ + ไวยากรณ์ของสัปดาห์ ผ่าน 80% รับเหรียญ", 50);
  if(d===90) q("final","状","พิธีจบหลักสูตร: บอสใหญ่ 30 ข้อ", "รวมทุกอย่างตลอด 90 วัน", 100);
  return p;
}
function startDay(){ return dateToDayNum(S.start); }
function calendarDay(){ return localDayNum() - startDay() + 1; }
function curDay(){ return Math.max(1, Math.min(TOTAL_DAYS, calendarDay())); }
function dayRec(d){ return S.days[d] || (S.days[d] = {q:{}}); }
function dayDone(d){ const p = plan(d), r = S.days[d]; return !!r && p.quests.every(x => r.q[x.id]); }
function dayProgress(d){ const p = plan(d), r = S.days[d]; if(!r) return 0; return p.quests.filter(x=>r.q[x.id]).length / p.quests.length; }
function unlocked(d){ return d <= Math.max(1, calendarDay()) || dayDone(d-1); }

/* ============ XP / RANK / STREAK ============ */
const RANKS = [
  [0,"童生","นักเรียนหัดใหม่"],[400,"秀才","ผ่านสอบระดับอำเภอ"],[1200,"举人","ผ่านสอบระดับมณฑล"],
  [2600,"贡士","ผ่านสอบรวมเมืองหลวง"],[4500,"进士","บัณฑิตหลวง"],[7000,"探花","อันดับ 3 สอบหลวง"],
  [9500,"榜眼","อันดับ 2 สอบหลวง"],[12500,"状元","จอหงวน อันดับ 1"]];
function rankOf(xp){ let i=0; RANKS.forEach((r,k)=>{ if(xp>=r[0]) i=k; }); return i; }
function addXP(n, why){
  if(!n) return;
  const before = rankOf(S.xp);
  S.xp += n; const t = localDayNum();
  S.xplog[t] = (S.xplog[t]||0) + n;
  if(S.streak.last !== t){ S.streak.cur = (S.streak.last === t-1) ? S.streak.cur+1 : 1; S.streak.last = t; S.streak.best = Math.max(S.streak.best, S.streak.cur); }
  const after = rankOf(S.xp);
  checkBadges(); save(); updateTop();
  if(after > before) levelUp(after);
}
function completeQuest(d, id, xp){
  const r = dayRec(d); if(r.q[id]) { save(); return false; }
  r.q[id] = Date.now(); addXP(xp);
  if(dayDone(d)){ r.done = Date.now(); addXP(30); toast(`ครบภารกิจวันที่ ${d} แล้ว! +30 XP โบนัส`); }
  else toast(`ภารกิจสำเร็จ +${xp} XP`);
  checkBadges(); save(); return true;
}
