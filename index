<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>HSK4 90 วัน</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=Noto+Serif+SC:wght@600;900&family=Noto+Sans+SC:wght@400;500&display=swap">
<script src="https://cdn.jsdelivr.net/npm/hanzi-writer@3.7.2/dist/hanzi-writer.min.js"></script>
<style>
/* Layout: an exam-hall journey — sticky rank bar on top, one centered study column, 90-node route map; jade ink + cinnabar seal stamps for wins */
:root{
  --bg:#eef2ef; --surface:#ffffff; --surface2:#e3eae6; --line:#cfd9d4;
  --ink:#13211d; --muted:#5a6b65; --jade:#1d7a66; --jade-soft:#d5ebe4;
  --seal:#c8402e; --seal-soft:#f6dcd6; --gold:#c98a12; --gold-soft:#f7e8c6;
  --good:#1f8a4c; --bad:#c23a2b;
  --f-ui:"IBM Plex Sans Thai","Noto Sans SC",system-ui,sans-serif;
  --f-han:"Noto Serif SC","Songti SC","SimSun",serif;
  --f-zh:"Noto Sans SC","PingFang SC","Microsoft YaHei",sans-serif;
  --r:14px;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0e1714; --surface:#16231f; --surface2:#1d2d28; --line:#2b3f38;
  --ink:#e6efeb; --muted:#93a8a0; --jade:#4cc3a5; --jade-soft:#173a32;
  --seal:#ef6a55; --seal-soft:#3d1f1a; --gold:#e7b54b; --gold-soft:#3a2e14;
  --good:#5bd08c; --bad:#ff7a6b; color-scheme:dark }}
:root[data-theme="dark"]{
  --bg:#0e1714; --surface:#16231f; --surface2:#1d2d28; --line:#2b3f38;
  --ink:#e6efeb; --muted:#93a8a0; --jade:#4cc3a5; --jade-soft:#173a32;
  --seal:#ef6a55; --seal-soft:#3d1f1a; --gold:#e7b54b; --gold-soft:#3a2e14;
  --good:#5bd08c; --bad:#ff7a6b; color-scheme:dark }
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--f-ui);font-size:15px;line-height:1.6;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:0 48px}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--surface)}
button,input,textarea,select{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.zh{font-family:var(--f-zh)} .han{font-family:var(--f-han);font-weight:900}
.wrap{max-width:860px;margin:0 auto}
h1,h2,h3{text-wrap:balance;line-height:1.3;margin:0}
h1{font-size:1.6rem} h2{font-size:1.25rem} h3{font-size:1.05rem}
.muted{color:var(--muted)} .small{font-size:.85rem}
.eyebrow{font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
/* top bar */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--surface);border-bottom:1px solid var(--line);
  margin-left:calc(-1 * max(16px,env(safe-area-inset-left,0px)));margin-right:calc(-1 * max(16px,env(safe-area-inset-right,0px)));
  padding:10px max(16px,env(safe-area-inset-right,0px)) 10px max(16px,env(safe-area-inset-left,0px))}
.top .wrap{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:10px;background:none;border:0;padding:0}
.seal{display:inline-grid;place-items:center;width:38px;height:38px;border-radius:8px;background:var(--seal);color:#fff;font-family:var(--f-han);font-weight:900;font-size:1.1rem;transform:rotate(-4deg)}
.rankbox{flex:1;min-width:180px}
.rankline{display:flex;justify-content:space-between;gap:8px;font-size:.85rem}
.bar{height:8px;border-radius:99px;background:var(--surface2);overflow:hidden}
.bar>i{display:block;height:100%;background:linear-gradient(90deg,var(--jade),var(--gold));border-radius:99px;transition:width .5s}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:99px;background:var(--surface2);font-size:.82rem;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}
.chip.fire{background:var(--seal-soft);color:var(--seal)} .chip.xp{background:var(--gold-soft);color:var(--gold)} .chip.day{background:var(--jade-soft);color:var(--jade)}
nav.tabs{display:flex;gap:4px;overflow-x:auto;margin:14px 0 18px;padding-bottom:2px}
nav.tabs button{border:0;background:transparent;padding:8px 14px;border-radius:99px;white-space:nowrap;font-weight:600;color:var(--muted)}
nav.tabs button[aria-current="true"]{background:var(--ink);color:var(--bg)}
/* cards */
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:18px}
.stack{display:flex;flex-direction:column;gap:14px}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px}
.btn{border:1px solid var(--line);background:var(--surface);padding:9px 16px;border-radius:10px;font-weight:600;display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.btn:hover{border-color:var(--jade)}
.btn.pri{background:var(--jade);border-color:var(--jade);color:#fff}
:root[data-theme="dark"] .btn.pri{color:#06120f}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .btn.pri{color:#06120f}}
.btn.seal{background:var(--seal);border-color:var(--seal);color:#fff}
.btn.ghost{background:transparent}
.btn.wrap{white-space:normal}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn.sm{padding:5px 10px;font-size:.85rem}
.iconbtn{border:1px solid var(--line);background:var(--surface);width:36px;height:36px;border-radius:50%;display:inline-grid;place-items:center;flex:none}
.iconbtn:hover{border-color:var(--jade);color:var(--jade)}
/* hero today */
.hero{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:center}
.daynum{font-family:var(--f-han);font-size:3.4rem;line-height:1;color:var(--jade)}
.daynum small{font-size:1rem;color:var(--muted);font-family:var(--f-ui);font-weight:600}
.phase{display:inline-block;padding:2px 10px;border-radius:6px;background:var(--gold-soft);color:var(--gold);font-weight:700;font-size:.8rem}
/* quests */
.quest{display:grid;grid-template-columns:44px 1fr auto;gap:12px;align-items:center;padding:12px 14px;border-radius:12px;border:1px solid var(--line);background:var(--surface)}
.quest .qi{width:44px;height:44px;border-radius:10px;display:grid;place-items:center;background:var(--surface2);font-family:var(--f-han);font-size:1.25rem}
.quest.done{background:var(--jade-soft);border-color:transparent}
.quest.done .qi{background:var(--jade);color:#fff}
.quest .qt{min-width:0}
.quest .qt b{display:block}
.stamp{font-family:var(--f-han);color:var(--seal);border:2px solid var(--seal);border-radius:6px;padding:0 6px;transform:rotate(-8deg);display:inline-block;font-size:.9rem}
/* map */
.weeks{display:flex;flex-direction:column;gap:10px}
.week{display:grid;grid-template-columns:72px 1fr;gap:10px;align-items:center}
.week .wl{font-size:.8rem;color:var(--muted);font-weight:600}
.nodes{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px}
.node{aspect-ratio:1;max-width:100%;border-radius:10px;border:1px solid var(--line);background:var(--surface);display:grid;place-items:center;font-weight:700;font-variant-numeric:tabular-nums;font-size:.9rem;position:relative}
.node.done{background:var(--jade);color:#fff;border-color:var(--jade)}
.node.part{background:var(--jade-soft);border-color:var(--jade)}
.node.today{outline:3px solid var(--gold);outline-offset:1px}
.node.locked{opacity:.4;cursor:not-allowed}
.node.late{border-color:var(--seal);color:var(--seal)}
.node .tag{position:absolute;top:-6px;right:-6px;font-size:.6rem;background:var(--seal);color:#fff;border-radius:99px;padding:0 5px;font-family:var(--f-zh)}
.node .tag.boss{background:var(--gold)}
/* flashcard */
.flash{text-align:center;padding:28px 18px}
.flash .big{font-family:var(--f-han);font-size:clamp(3rem,13vw,5.5rem);line-height:1.1}
.flash .py{font-size:1.4rem;color:var(--jade);font-weight:600}
.ex{background:var(--surface2);border-radius:10px;padding:10px 14px;text-align:left}
.ex .zh{font-size:1.1rem}
.opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px}
.opt{border:1.5px solid var(--line);background:var(--surface);padding:12px 14px;border-radius:12px;text-align:left;font-size:1rem;display:flex;gap:10px;align-items:flex-start}
.opt .k{font-weight:700;color:var(--muted);flex:none}
.opt:hover:not(:disabled){border-color:var(--jade)}
.opt.sel{border-color:var(--jade);background:var(--jade-soft)}
.opt.ok{border-color:var(--good);background:color-mix(in srgb,var(--good) 14%,var(--surface))}
.opt.no{border-color:var(--bad);background:color-mix(in srgb,var(--bad) 12%,var(--surface))}
.opt:disabled{cursor:default}
.opt.zhopt{font-family:var(--f-zh);font-size:1.15rem}
.feedback{border-radius:12px;padding:12px 14px;background:var(--surface2)}
.feedback.ok{background:color-mix(in srgb,var(--good) 14%,var(--surface))}
.feedback.no{background:color-mix(in srgb,var(--bad) 12%,var(--surface))}
.combo{font-family:var(--f-han);color:var(--gold);font-size:1.2rem}
.progress{display:flex;gap:10px;align-items:center}
.progress .bar{flex:1}
/* match game */
.match{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.tile{border:1.5px solid var(--line);background:var(--surface);border-radius:12px;padding:12px;min-height:58px;font-size:1rem}
.tile.h{font-family:var(--f-han);font-size:1.5rem}
.tile.sel{border-color:var(--gold);background:var(--gold-soft)}
.tile.gone{visibility:hidden}
.tile.shake{animation:shake .35s}
@keyframes shake{25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
/* dialogue */
.line{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:start;padding:10px 0;border-bottom:1px dashed var(--line)}
.line:last-child{border-bottom:0}
.who{font-weight:700;color:var(--jade);font-size:.85rem;min-width:52px;font-family:var(--f-zh)}
.line .zh{font-size:1.12rem}
.line .py{color:var(--jade);font-size:.88rem}
.line.playing{background:var(--gold-soft);border-radius:8px}
.hide-py .py{display:none} .hide-th .th{display:none}
/* tables & lists */
.tbl{width:100%;border-collapse:collapse}
.tbl td,.tbl th{padding:8px 6px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
.tbl th{font-size:.78rem;color:var(--muted);letter-spacing:.04em}
.scroll{overflow-x:auto}
input[type=search],input[type=text],input[type=date],textarea,select{width:100%;border:1.5px solid var(--line);background:var(--surface);border-radius:10px;padding:10px 12px}
textarea{min-height:110px;font-family:var(--f-zh);font-size:1.05rem}
textarea:focus,input:focus,select:focus{border-color:var(--jade);outline:none}
.pill{display:inline-block;padding:1px 8px;border-radius:99px;background:var(--surface2);font-size:.75rem;font-weight:600}
.pill.j{background:var(--jade-soft);color:var(--jade)} .pill.s{background:var(--seal-soft);color:var(--seal)} .pill.g{background:var(--gold-soft);color:var(--gold)}
.passage{font-family:var(--f-zh);font-size:1.08rem;line-height:1.9;background:var(--surface2);padding:14px;border-radius:12px}
.blank{display:inline-block;min-width:2.4em;border-bottom:2px solid var(--jade);text-align:center;color:var(--jade);font-weight:700}
.secnav{display:flex;gap:6px;flex-wrap:wrap}
.secnav button{border:1px solid var(--line);background:var(--surface);padding:6px 12px;border-radius:99px;font-weight:600}
.secnav button[aria-current="true"]{background:var(--jade);color:#fff;border-color:var(--jade)}
.timer{font-variant-numeric:tabular-nums;font-weight:700;font-size:1.1rem}
.score{font-family:var(--f-han);font-size:3rem;line-height:1}
.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:99px;font-weight:600;z-index:20;max-width:calc(100% - 32px);text-align:center}
.levelup{position:fixed;inset:0;display:grid;place-items:center;background:color-mix(in srgb,var(--bg) 70%,transparent);z-index:30;padding:16px}
.levelup .card{text-align:center;max-width:360px}
.badges{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px}
.badge{border:1px solid var(--line);border-radius:12px;padding:12px;text-align:center;background:var(--surface)}
.badge .bi{font-family:var(--f-han);font-size:1.6rem;width:52px;height:52px;margin:0 auto 6px;border-radius:50%;display:grid;place-items:center;border:2px solid var(--line);color:var(--muted)}
.badge.on .bi{border-color:var(--seal);color:var(--seal);background:var(--seal-soft)}
.badge:not(.on){opacity:.55}
.note{border-left:4px solid var(--gold);background:var(--gold-soft);padding:10px 14px;border-radius:0 10px 10px 0}
.kbd{font-family:ui-monospace,monospace;font-size:.8rem;background:var(--surface2);padding:1px 6px;border-radius:5px}
details>summary{cursor:pointer;font-weight:600}
.bars{display:flex;align-items:flex-end;gap:10px;height:160px;padding-top:10px}
.bars .b{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;justify-content:flex-end;height:100%;min-width:0}
.bars .b i{display:block;width:100%;max-width:46px;border-radius:6px 6px 0 0;background:var(--jade)}
.bars .b i.pass{background:var(--good)} .bars .b i.fail{background:var(--seal)}
.bars .b span{font-size:.75rem;color:var(--muted);font-variant-numeric:tabular-nums}
.hwgrid{display:grid;grid-template-columns:auto 1fr;gap:16px;align-items:start}
.hwbox{width:260px;max-width:100%;aspect-ratio:1;border:2px solid var(--seal);border-radius:8px;background:
  linear-gradient(var(--line),var(--line)) center/100% 1px no-repeat,linear-gradient(var(--line),var(--line)) center/1px 100% no-repeat,var(--surface);display:grid;place-items:center;touch-action:none}
.hwbox svg{display:block}
.sline{min-height:58px;border-bottom:2px solid var(--jade);display:flex;flex-wrap:wrap;gap:6px;align-items:center;padding:6px 0}
.sbank{display:flex;flex-wrap:wrap;gap:8px;min-height:48px}
.chunk{font-family:var(--f-zh);font-size:1.15rem;border:1.5px solid var(--line);background:var(--surface);border-radius:10px;padding:8px 12px}
.chunk.on{background:var(--jade-soft);border-color:var(--jade)}
.chunk:disabled{cursor:default}
.ck{border-bottom:2px solid var(--gold);margin-right:4px}
.hwlist{display:grid;grid-template-columns:repeat(auto-fill,minmax(48px,1fr));gap:6px}
.hwc{font-family:var(--f-han);font-size:1.5rem;aspect-ratio:1;border:1px solid var(--line);background:var(--surface);border-radius:8px}
.hwc.on{background:var(--jade-soft);border-color:var(--jade);color:var(--jade)}
@media (max-width:560px){.hwgrid{grid-template-columns:1fr;justify-items:center}}
@media (max-width:560px){
  .hero{grid-template-columns:1fr}
  .quest{grid-template-columns:38px 1fr;}
  .quest .qa{grid-column:1/-1}
  .week{grid-template-columns:1fr}
  .daynum{font-size:2.6rem}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
