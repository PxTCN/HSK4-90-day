/* ============ BOSS ============ */
function bossItems(d, n){
  const from = Math.max(1, d-6); let wids = [];
  for(let x=from; x<=d; x++) wids = wids.concat(wordsForDay(x));
  if(wids.length < 10){ const weak = Object.keys(S.srs).filter(k=>S.srs[k][0]<=2).map(Number); wids = weak.length>=10 ? weak : (Object.keys(S.srs).length>=10 ? Object.keys(S.srs).map(Number) : V4.map(w=>w.id)); }
  let gids = []; for(let x=from; x<=d; x++) gids = gids.concat(gramForDay(x));
  if(gids.length < 3) gids = (Object.keys(S.gram).length>=5 ? Object.keys(S.gram).map(Number) : GRAM.map(g=>g.id));
  const nw = Math.round(n*2/3), ng = n - nw;
  const types = ["cloze","a2h","h2t","t2h"];
