      const size = Math.min(260, box.clientWidth || 260);
      const wr = HanziWriter.create(box, c, { width:size, height:size, padding:12, showOutline:true, showCharacter:false,
        strokeColor: cssColor("--ink"), outlineColor: cssColor("--line"), drawingColor: cssColor("--jade"), highlightColor: cssColor("--gold"),
        drawingWidth: 22, strokeAnimationSpeed: 1, delayBetweenStrokes: 250, charDataLoader: (ch, done) => done(STROKES[ch]) });
      const fb = $("#hwfb", el);
      const quiz = (outline) => { wr.cancelQuiz(); wr.hideCharacter(); outline ? wr.showOutline() : wr.hideOutline();
        fb.innerHTML = `<div class="small muted">${outline?"เขียนทับเส้นจางตามลำดับขีด":"เขียนเองทั้งตัว ผิด 3 ครั้งในขีดเดียวกันจะมีคำใบ้"}</div>`;
        wr.quiz({ showHintAfterMisses: 3, onComplete: s => {
          const m = s.totalMistakes;
          fb.innerHTML = `<div class="feedback ${m<=1?"ok":(m<=4?"":"no")} small"><b>${m===0?"สมบูรณ์แบบ!":(m<=2?"ดีมาก":"ยังผิดลำดับ/ทิศขีดหลายครั้ง")}</b> ผิด ${m} ครั้ง ${m>2?"— ลองดูลำดับขีดอีกรอบแล้วเขียนใหม่ ขีดแนวนอนเขียนซ้ายไปขวา แนวตั้งบนลงล่าง ทำจากบนลงล่าง ซ้ายไปขวา":""}</div>`;
          if(!outline){ S.hwd[c] = Math.min(S.hwd[c] ?? 99, m); save(); }
          speak(info.single ? c : (w ? w.h : c)); } }); };
      $("#ani",el).onclick = () => { wr.cancelQuiz(); wr.showOutline(); wr.animateCharacter(); };
      $("#trace",el).onclick = () => quiz(true);
      $("#free",el).onclick = () => quiz(false);
      setTimeout(() => { wr.animateCharacter(); }, 300);
    }
    $("#skip",el).onclick = () => { k++; draw(); };
  };
  draw();
}

/* --- reorder --- */
function reorderTask(el, items, d, onDone, {title="เรียงคำเป็นประโยค"} = {}){
  let k = 0, ok = 0;
  const draw = () => {
    if(k >= items.length){ onDone(ok, items.length); return; }
    const it = items[k], idx = it._i ?? k;
    let bank = it.chunks.map((t,i)=>({t,i})); for(let n=0; n<8; n++){ bank = shuffle(bank); if(bank.map(x=>x.i).join() !== it.chunks.map((_,i)=>i).join()) break; }
    const line = []; let checked = false;
    const paint = () => {
      el.innerHTML = `<div class="card stack"><div class="progress"><span class="small muted">${esc(title)} ${k+1}/${items.length}</span><div class="bar"><i style="width:${k/items.length*100}%"></i></div></div>
        <div class="small muted">แตะคำเรียงเป็นประโยคที่ถูกต้อง ${it.w?`· คำเป้าหมาย <span class="zh" style="color:var(--seal);font-weight:700">${esc(it.w)}</span>`:""}</div>
        <div class="small">ความหมาย: ${esc(it.th)}</div>
        <div class="sline" id="ln">${line.length ? line.map((x,j)=>`<button class="chunk on" data-j="${j}" ${checked?"disabled":""}>${esc(x.t)}</button>`).join("") : '<span class="muted small">แตะคำด้านล่าง…</span>'}</div>
        <div class="sbank">${bank.map((x,j)=>`<button class="chunk" data-b="${j}" ${checked?"disabled":""}>${esc(x.t)}</button>`).join("")}</div>
        <div class="row"><button class="btn" id="clr" ${checked||!line.length?"disabled":""}>ล้าง</button><button class="btn pri" id="chk" ${checked||bank.length?"disabled":""}>ตรวจ</button></div><div id="fb"></div></div>`;
      el.querySelectorAll("[data-b]").forEach(b => b.onclick = () => { line.push(bank.splice(+b.dataset.b,1)[0]); paint(); });
      el.querySelectorAll("[data-j]").forEach(b => b.onclick = () => { bank.push(line.splice(+b.dataset.j,1)[0]); paint(); });
      $("#clr",el).onclick = () => { bank = bank.concat(line.splice(0)); paint(); };
      $("#chk",el).onclick = check;
    };
    const check = () => {
      checked = true; const mine = line.map(x=>x.t).join("");
      const good = [it.zh].concat(it.alt||[]).some(s => stripP(s) === stripP(mine));
      if(good){ ok++; clearMistake({d, t:"r", i:idx}); } else noteMistake({d, t:"r", i:idx});
      paint();
      const firstBad = line.findIndex((x,j)=>x.i!==j);
      $("#fb",el).innerHTML = `<div class="feedback ${good?"ok":"no"} stack" style="gap:6px"><b>${good?"ถูกต้อง!":"ยังไม่ถูก"}</b>
        ${good?"":`<div class="small">ของคุณ: <s class="zh">${esc(mine)}</s>${firstBad>=0?` · เริ่มผิดตั้งแต่ “${esc(line[firstBad].t)}”`:""}</div>`}
        <div class="row" style="flex-wrap:nowrap"><span class="zh" style="font-size:1.2rem">${it.chunks.map(c=>`<span class="ck">${esc(c)}</span>`).join("")}</span>${sayBtn(it.zh)}</div>
        <div class="small" style="color:var(--jade)">${esc(it.py)}</div>
        <div class="small"><b>ทำไมเรียงแบบนี้:</b> ${esc(it.why)}</div>
        <div class="row">${good?"":'<button class="btn" id="again">ลองใหม่</button>'}<button class="btn pri" id="nx">${k+1<items.length?"ข้อต่อไป →":"ไปต่อ →"}</button></div></div>`;
      speak(it.zh);
      if(!good) $("#again",el).onclick = () => { bank = it.chunks.map((t,i)=>({t,i})); bank = shuffle(bank); line.length = 0; checked = false; paint(); };
      $("#nx",el).onclick = () => { k++; draw(); };
    };
    paint();
  };
  draw();
}

/* --- pick correct sentence --- */
function pickTask(el, items, d, onDone){
  const qs = items.map((p, j) => ({ prompt:`<div class="eyebrow">จับผิดประโยค</div><div>ประโยคไหน <b>ถูกต้อง</b>?</div>`, opts:p.opts, ans:p.ans, zh:true,
    after: `<div class="row"><span class="zh">${esc(p.opts[p.ans])}</span>${sayBtn(p.opts[p.ans])}</div><div class="small">${esc(p.why)}</div>`,
    onAnswer: ok => { const m = {d: p._d ?? d, t:"p", i:p._i ?? j}; ok ? clearMistake(m) : noteMistake(m); if(ok) speak(p.opts[p.ans]); } }));
  runQuiz(el, qs, { title:"จับผิดประโยค", combo:false, onDone:(ok,t)=>onDone(ok,t) });
}

/* --- translate Thai -> Chinese --- */
function translateTask(el, it, d, onDone){
  el.innerHTML = `<div class="card stack"><div class="eyebrow">แปลไทย → จีน</div><h2 style="font-weight:600">${esc(it.th)}</h2>
    <textarea id="ans" style="min-height:80px" placeholder="พิมพ์ภาษาจีน (ใช้คีย์บอร์ดพินอินได้)"></textarea>
    <details><summary>คำใบ้</summary><div class="small">โครงสร้างสำคัญ: ${it.keys.map(k=>`<span class="pill j zh">${esc(k)}</span>`).join(" ")}</div></details>
    <div class="row"><button class="btn pri" id="chk">ตรวจ</button></div><div id="ai"></div><div id="res"></div></div>`;
  aiBox($("#ai",el), "translate", it, () => $("#ans",el).value);
  $("#chk",el).onclick = () => {
    const a = $("#ans",el).value.trim(); const A = stripP(a);
    const exact = a && [it.zh].concat(it.alt||[]).some(s => stripP(s) === A);
    const miss = it.keys.filter(k => !A.includes(stripP(k)));
    const good = exact || (a && !miss.length);
    const m = {d, t:"x", i:0}; good ? clearMistake(m) : noteMistake(m);
    $("#res",el).innerHTML = `<div class="feedback ${good?"ok":"no"} stack" style="gap:6px"><b>${!a?"ยังไม่ได้พิมพ์":(exact?"ถูกต้องตรงกับคำตอบ!":(good?"ใช้โครงสร้างหลักครบ ✓ เทียบสำนวนกับคำตอบด้านล่าง":"ยังขาดโครงสร้างสำคัญ"))}</b>
      ${miss.length && a?`<div class="small">ขาด: ${miss.map(k=>`<span class="pill s zh">${esc(k)}</span>`).join(" ")}</div>`:""}
      <div class="row" style="flex-wrap:nowrap"><span class="zh" style="font-size:1.15rem">${esc(it.zh)}</span>${sayBtn(it.zh)}</div><div class="small" style="color:var(--jade)">${esc(it.py)}</div>
      ${(it.alt||[]).length?`<div class="small muted">แปลแบบอื่นที่ถูก: <span class="zh">${it.alt.map(esc).join(" / ")}</span></div>`:""}
      <div class="small"><b>วิธีคิด:</b> ${esc(it.why)}</div>${AI?'<div class="small muted">อยากรู้ว่าประโยคของคุณผิดตรงไหน กด "ให้ AI ช่วยตรวจ" ด้านบน</div>':""}
      <div class="row"><button class="btn pri" id="fin">ไปต่อ →</button></div></div>`;
    speak(it.zh); $("#fin",el).onclick = () => onDone(good);
  };
}

/* --- the daily quest --- */
QUESTS.write = (el, d, done) => {
  const W = WR[d-1], pic = SP.sentences[d<=LEARN_DAYS ? d-1 : (d*7)%60];
  const steps = ["คัดตัวอักษร","เรียงประโยค","จับผิด","แปล","แต่งประโยคจากภาพ"]; let score = {r:0, p:0};
  const head = (i) => `<div class="secnav" style="margin-bottom:10px">${steps.map((s,j)=>`<button disabled aria-current="${i===j}">${j+1}. ${s}</button>`).join("")}</div><div id="ws"></div>`;
  const step = (i) => { el.innerHTML = head(i); const box = $("#ws", el); window.scrollTo(0,0);
    if(i===0) handwriting(box, hwForDay(d), () => step(1));
    if(i===1) reorderTask(box, W.reorder.map((x,j)=>({...x,_i:j})), d, (ok) => { score.r = ok; step(2); });
    if(i===2) pickTask(box, W.pick.map((x,j)=>({...x,_i:j})), d, (ok) => { score.p = ok; step(3); });
    if(i===3) translateTask(box, W.translate, d, () => step(4));
    if(i===4) writeSentence(box, pic, () => { save(); done(score.r + score.p*2); el.innerHTML = "";
      resultCard(el, score.r + score.p, 7, {title:"เวิร์กช็อปเขียนวันนี้", pass:0.7, extra:`<p class="small muted">เรียงประโยคถูก ${score.r}/5 · จับผิดถูก ${score.p}/2 · ข้อที่ผิดถูกเก็บไว้ใน "สมุดประโยคที่เคยผิด" หน้าทบทวน</p>`, onBack:()=>go("day",{d})}); });
  };
  step(0);
};

/* --- mistake notebook (used by review tab) --- */
function mistakeReview(el, onBack){
  const ms = shuffle(S.mist).slice(0, 15);
  if(!ms.length){ el.innerHTML = `<div class="card"><b>ยังไม่มีประโยคที่เคยผิด</b> เก่งมาก!</div>`; return; }
  const rs = ms.filter(m=>m.t==="r").map(m=>({...WR[m.d-1].reorder[m.i], _i:m.i, _d:m.d}));
  const ps = ms.filter(m=>m.t==="p").map(m=>({...WR[m.d-1].pick[m.i], _i:m.i, _d:m.d}));
  const xs = ms.filter(m=>m.t==="x");
  const runR = (i) => { if(i>=rs.length){ runP(); return; } reorderTask(el, [rs[i]], rs[i]._d, () => runR(i+1), {title:`ทบทวนประโยคที่เคยผิด (วันที่ ${rs[i]._d})`}); };
  const runP = () => { if(!ps.length){ runX(0); return; } pickTask(el, ps, 0, () => runX(0)); };
  const runX = (i) => { if(i>=xs.length){ save(); el.innerHTML = `<div class="card stack"><b>ทบทวนครบแล้ว</b><span class="small muted">ข้อที่ตอบถูกจะถูกนำออกจากสมุด เหลือ ${S.mist.length} ข้อ</span><div class="row"><button class="btn pri" id="bk">กลับ</button></div></div>`; $("#bk",el).onclick = onBack; return; }
    translateTask(el, WR[xs[i].d-1].translate, xs[i].d, () => runX(i+1)); };
  runR(0);
}

/* --- extend review tab & library --- */
const _reviewView = VIEWS.review;
VIEWS.review = (el) => {
  _reviewView(el);
  const card = document.createElement("div"); card.className = "card stack"; card.style.marginTop = "14px";
  card.innerHTML = `<div class="eyebrow">สมุดประโยคที่เคยผิด</div><h2>${S.mist.length} ข้อรอแก้ตัว</h2><p class="small muted" style="margin:0">ทุกข้อที่เรียงผิด เลือกผิด หรือแปลไม่ครบในเวิร์กช็อปเขียนจะมาอยู่ที่นี่ พร้อมคำอธิบาย ทำถูกแล้วจะหายจากสมุด</p><div class="row"><button class="btn seal" id="mist" ${S.mist.length?"":"disabled"}>ทบทวนข้อที่เคยผิด</button><button class="btn" id="hwr">คัดตัวอักษรทบทวน 5 ตัว</button></div>`;
  el.insertBefore(card, $("#rv", el));
  $("#mist",card).onclick = () => mistakeReview($("#rv",el), () => go("review"));
  $("#hwr",card).onclick = () => { const learned = Object.keys(S.hwd); handwriting($("#rv",el), pick(learned.length>=5?learned:HW, 5), () => { toast("คัดตัวอักษรครบแล้ว"); go("review"); }); };
};
const _libView = VIEWS.library;
VIEWS.library = (el, args) => {
  if(args.tab === "hw"){
    _libView(el, {tab:"v4"}); // draws nav
    el.querySelectorAll("[data-tab]").forEach(b => b.setAttribute("aria-current", "false"));
    const lib = $("#lib", el);
    lib.innerHTML = `<div class="card stack"><div class="eyebrow">ตัวอักษรที่ต้องเขียนได้ HSK4 (书写字 150 ตัว ตามหลักสูตร 2025)</div><p class="small muted" style="margin:0">ตัวสีเขียว = เคยเขียนเองได้แล้ว ผิดไม่เกิน 2 ครั้ง · แตะเพื่อฝึก</p>
      <div class="hwlist">${HW.map(c=>`<button class="hwc ${S.hwd[c]!==undefined && S.hwd[c]<=2?"on":""}" data-c="${esc(c)}">${esc(c)}</button>`).join("")}</div></div>`;
    lib.querySelectorAll("[data-c]").forEach(b => b.onclick = () => { handwriting(lib, [b.dataset.c], () => go("library",{tab:"hw"})); window.scrollTo(0,0); });
  } else _libView(el, args);
  const nav = el.querySelector(".secnav");
  if(nav && !nav.querySelector('[data-tab="hw"]')){ const b = document.createElement("button"); b.dataset.tab = "hw"; b.textContent = "ตัวอักษรที่ต้องเขียน (150)"; b.setAttribute("aria-current", String(args.tab==="hw")); b.onclick = () => go("library",{tab:"hw"}); nav.appendChild(b); }
};

/* ============ BOOT ============ */
render();
initCloud(); initAI();

</script>

