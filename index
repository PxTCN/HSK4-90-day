function runQuiz(el, items, {title="", onDone, combo=true, xpEach=0, review=null} = {}){
  let i = 0, ok = 0, streak = 0, answered = false; const wrong = [];
  const draw = () => {
    if(i >= items.length){ stopSpeak(); onDone && onDone(ok, items.length, wrong); return; }
    const it = items[i]; answered = false;
    el.innerHTML = `<div class="card stack">
      <div class="progress"><span class="small muted">${esc(title)} ${i+1}/${items.length}</span><div class="bar"><i style="width:${i/items.length*100}%"></i></div>${combo && streak>=2 ? `<span class="combo">连×${streak}</span>`:""}</div>
      <div>${it.prompt}</div>
      <div class="opts">${it.opts.map((o,k)=>`<button class="opt ${it.zh?"zhopt":""}" data-k="${k}"><span class="k">${L(k)}</span><span>${esc(o)}</span></button>`).join("")}</div>
      <div id="fb"></div></div>`;
    if(it.say) setTimeout(()=>speak(it.say), 150);
    el.querySelectorAll(".opt").forEach(b => b.onclick = () => {
      if(answered) return; answered = true;
      const k = +b.dataset.k, good = k === it.ans;
      el.querySelectorAll(".opt").forEach((x,j)=>{ x.disabled = true; if(j===it.ans) x.classList.add("ok"); else if(j===k) x.classList.add("no"); });
      if(good){ ok++; streak++; } else { streak = 0; wrong.push(it); }
      it.onAnswer && it.onAnswer(good);
      if(xpEach && good) addXP(xpEach + (combo && streak>=5 ? 1 : 0));
      const fb = $("#fb", el);
      fb.innerHTML = `<div class="feedback ${good?"ok":"no"} stack" style="gap:6px"><b>${good ? "ถูกต้อง!" : "ยังไม่ถูก คำตอบคือ "+L(it.ans)}</b>${it.after||""}${it.exp?`<div>${esc(it.exp)}</div>`:""}<div class="row"><button class="btn pri" id="nx">${i+1<items.length?"ข้อต่อไป →":"ดูผล"}</button></div></div>`;
      $("#nx", el).onclick = () => { i++; draw(); };
      $("#nx", el).focus();
    });
  };
  draw();
}
