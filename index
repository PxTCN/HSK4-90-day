/* word question builders */
function distractors(w, field, pool, n=3){
  const same = pool.filter(x => x.id!==w.id && x[field]!==w[field] && x.pos===w.pos);
  const rest = pool.filter(x => x.id!==w.id && x[field]!==w[field]);
  const out = []; const seen = new Set([w[field]]);
  for(const x of shuffle(same).concat(shuffle(rest))){ if(!seen.has(x[field])){ seen.add(x[field]); out.push(x[field]); } if(out.length>=n) break; }
  return out;
}
function wordQ(w, type, onAnswer){
  const pool = w.lv===4 ? V4 : V13;
  if(type==="cloze" && !(w.ex && w.ex.includes(w.h))) type = "t2h";
  let prompt, field, zh = false, say = null;
  if(type==="h2t"){ prompt = `<div class="flash" style="padding:8px"><div class="big">${esc(w.h)}</div>${sayBtn(w.h)}</div><div class="muted small" style="text-align:center">คำนี้แปลว่าอะไร?</div>`; field="th"; }
  else if(type==="t2h"){ prompt = `<div class="eyebrow">เลือกคำภาษาจีน</div><h2>${esc(w.th)}</h2>`; field="h"; zh=true; }
  else if(type==="a2h"){ prompt = `<div class="row"><button class="btn" data-say="${esc(w.h)}">🔊 ฟังอีกครั้ง</button><span class="muted">ฟังแล้วเลือกคำที่ได้ยิน</span></div>`; field="h"; zh=true; say=w.h; }
  else { prompt = `<div class="eyebrow">เติมคำในช่องว่าง</div><div class="zh" style="font-size:1.3rem">${esc(w.ex.split(w.h).join("（　　）"))}</div><div class="muted small">${esc(w.exth)}</div>`; field="h"; zh=true; }
  const opts = shuffle([w[field], ...distractors(w, field, pool)]);
  return { prompt, opts, ans: opts.indexOf(w[field]), zh, say, onAnswer,
    after: `<div class="row"><span class="han" style="font-size:1.6rem">${esc(w.h)}</span><span class="zh" style="color:var(--jade)">${esc(w.py)}</span>${sayBtn(w.ex||w.h)}<span>${esc(w.th)}</span></div>${w.ex?`<div class="small"><span class="zh">${esc(w.ex)}</span> — ${esc(w.exth)}</div>`:""}` };
}
function gramQ(g, qi){ const q = g.quiz[qi]; return { prompt:`<div class="eyebrow">ไวยากรณ์ · ${esc(g.title)}</div><div class="zh" style="font-size:1.2rem">${esc(q.q)}</div>`, opts:q.opts, ans:q.ans, exp:q.exp, zh:true }; }

