function examScore(){
  const {L:Lq, R:Rq} = examQuestions(EX.t);
  const l = Lq.filter(q=>EX.ans[q.n]===q.ans).length, r = Rq.filter(q=>EX.ans[q.n]===q.ans).length;
  let w = 0; EX.t.writing.forEach(x => { w += EX.ws[x.n] || 0; });
  const Ls = Math.round(l/Lq.length*100), Rs = Math.round(r/Rq.length*100);
  return { l, r, Ls, Rs, Ws: Math.min(100, w), total: Ls + Rs + Math.min(100, w), nL:Lq.length, nR:Rq.length };
}
function autoWriteScores(){
  EX.t.writing.forEach(w => { const a = (EX.wr[w.n]||"").trim();
    if(w.n<70) EX.ws[w.n] = a && usesWord(a, w.word) && hanCount(a)>=6 ? 6 : 0;
    else { const n = hanCount(a); EX.ws[70] = n>=80 ? 25 : (n>=40 ? 15 : 0); } });
}
function recordExam(){
  const sc = examScore(), id = EX.t.id; const rec = S.tests[id] || (S.tests[id] = {best:0, attempts:[]});
  const at = { at: Date.now(), mode: EX.mode, L: sc.Ls, R: sc.Rs, W: sc.Ws, total: sc.total };
  if(EX.saved){ rec.attempts[rec.attempts.length-1] = at; } else { rec.attempts.push(at); EX.saved = true; }
  rec.best = Math.max(...rec.attempts.map(a=>a.total));
  rec.last = { ans: EX.ans, wr: EX.wr, ws: EX.ws };
  save();
}
function submitExam(el){
  stopSpeak(); clearInterval(EX.tick); EX.submitted = true; autoWriteScores(); recordExam();
