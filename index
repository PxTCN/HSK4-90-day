/* ============ AI HELPER ============ */
async function aiCheck(kind, ctx, answer){
  if(!AI) throw new Error("no-ai");
  const task = { sentence:`HSK 4 writing part 1 (看图，用词造句). The student must write ONE Chinese sentence using the word「${ctx.word}」that describes this picture: ${ctx.scene}.`,
    essay:`HSK 4 writing part 2: a short Chinese essay of at least 80 characters on this prompt: ${ctx.prompt}`,
    translate:`Translation drill: translate this Thai sentence into natural Chinese: ${ctx.th}`,
    speak:`HSK 4 speaking test. The student answered this prompt aloud and typed what they said (transcript): ${ctx.q}` }[kind];
  const prompt = `You are a strict but encouraging HSK 4 examiner helping a Thai learner.\n${task}\nModel answer for reference: ${ctx.model || ctx.zh}\n\nStudent answer:\n${answer}\n\nGrade it. Reply with ONLY a JSON object: {"score": integer 0-10 (10 = perfect, correct grammar and natural word choice, on topic${kind==="essay"?", at least 80 characters":""}), "corrected": "the student's answer corrected into natural Chinese (keep their idea; same text if already correct)", "feedback": "Thai feedback, 2-4 short sentences: what is good, each error and why, one tip"}`;
  return await AI.json(prompt, { modelTier:"quick" });
}
function aiBox(el, kind, ctx, getAnswer, onScore){
  if(!AI) return;
  const wrap = document.createElement("div"); wrap.className = "stack"; wrap.style.gap = "8px";
  wrap.innerHTML = `<div class="row"><button class="btn sm" type="button">✦ ให้ AI ช่วยตรวจ</button><span class="small muted">ใช้ Claude ตรวจไวยากรณ์และให้คะแนน 0–10</span></div><div class="ai-out"></div>`;
  const btn = wrap.querySelector("button"), out = wrap.querySelector(".ai-out");
  btn.onclick = async () => {
    const a = getAnswer().trim(); if(!a){ out.innerHTML = `<div class="feedback no">พิมพ์คำตอบก่อนนะ</div>`; return; }
    btn.disabled = true; out.innerHTML = `<div class="feedback">กำลังตรวจ…</div>`;
    try { const r = await aiCheck(kind, ctx, a);
      out.innerHTML = `<div class="feedback ${r.score>=7?"ok":(r.score>=4?"":"no")} stack" style="gap:4px"><b>คะแนน AI: ${esc(r.score)}/10</b><div class="zh">${esc(r.corrected)}</div><div class="small">${esc(r.feedback)}</div></div>`;
      onScore && onScore(Number(r.score)||0);
    } catch(e){ out.innerHTML = `<div class="feedback no">ตรวจไม่สำเร็จ${e && e.code==="rate_limited" ? " (ใช้งานถี่เกินไป ลองอีกครั้งใน 1 นาที)" : (e && e.code==="not_granted" ? " (ยังไม่ได้อนุญาตให้หน้านี้ถาม Claude)" : "")} — เทียบกับคำตอบตัวอย่างด้านล่างได้เลย</div>`; }
    btn.disabled = false;
  };
  el.appendChild(wrap);
}
